<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.0</version>
	</parent>
	<groupId>com.example.batch</groupId>
	<artifactId>spring-batch-parent</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>

	<modules>
		<module>batch-taskExecutor</module>
		<module>batch-future</module>
	</modules>
	<properties>
		<java.version>21</java.version>
	</properties>
	<!-- Dependency Management ensures all modules share uniform versions -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example.batch</groupId>
                <artifactId>batch-taskExecutor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example.batch</groupId>
                <artifactId>batch-future</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>